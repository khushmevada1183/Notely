{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"esModuleInterop": true,
		"removeComments": false,
		"preserveConstEnums": true,
		"sourceMap": false,
		"allowJs": true,
		"resolveJsonModule": true,
		"isolatedModules": false,
		"skipLibCheck": true,
		"outDir": "../out/vs",
		"types": [
			"@webgpu/types",
			"mocha",
			"semver",
			"sinon",
			"trusted-types",
			"winreg",
			"wicg-file-system-access"
		],
		"plugins": [
			{
				"name": "tsec",
				"exemptionConfig": "./tsec.exemptions.json"
			}
		]
	},
	"include": [
		"./*.ts",
		"./typings",
		"./vs/**/*.ts",
		"./vscode-dts/vscode.proposed.*.d.ts",
		"./vscode-dts/vscode.d.ts"
	],
	"exclude": [
		"vs/workbench/contrib/webview/browser/pre/service-worker.js",
		"server-main.ts",
		"server-cli.ts",
		"bootstrap-server.ts",
		"vs/workbench/test/browser/componentFixtures/**",
		"vs/workbench/api/test/**",
		"vs/workbench/contrib/terminalContrib/accessibility/browser/**",
		"vs/workbench/contrib/terminalContrib/inlineHint/browser/**",
		"vs/workbench/contrib/editTelemetry/test/**",
		"vs/workbench/contrib/testing/test/**",
		"vs/workbench/contrib/notebook/test/**",
		"vs/workbench/contrib/terminal/test/**",
		"vs/workbench/test/browser/aiCustomizationManagementSectionRegistry.test.ts",
		"vs/workbench/test/browser/workbenchTestServices.ts",
		"vs/workbench/contrib/notebook/test/**",
		"vs/workbench/contrib/notebook/browser/**",
		"vs/workbench/contrib/scm/browser/**",
		"vs/workbench/contrib/preferences/browser/**",
		"vs/workbench/contrib/debug/browser/**",
		"vs/workbench/**/test/**",
		"vs/workbench/test/**",
		"vs/workbench/contrib/search/browser/**",
		"vs/workbench/contrib/tasks/browser/**",
		"vs/workbench/contrib/interactive/**",
		"vs/workbench/contrib/replNotebook/**",
		"vs/workbench/contrib/markers/browser/**",
		"vs/workbench/contrib/welcomeGettingStarted/**",
		"vs/workbench/contrib/welcomeOnboarding/**",
		"vs/workbench/contrib/issue/**",
		"vs/workbench/contrib/editTelemetry/**",
