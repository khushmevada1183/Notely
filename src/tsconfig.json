		"vs/workbench/contrib/codeEditor/browser/dictation/**",
		"vs/workbench/contrib/codeEditor/browser/quickaccess/gotoSymbolQuickAccess.ts",
		"vs/workbench/api/browser/mainThreadNotebook*.ts",
		"vs/workbench/api/browser/mainThreadTerminal*.ts",
		"vs/workbench/api/browser/mainThreadInteractive*.ts",
		"vs/workbench/api/browser/mainThreadChat*.ts",
		"vs/workbench/api/browser/mainThreadMcp*.ts",
		"vs/workbench/api/browser/mainThreadLanguageModel*.ts",
		"vs/workbench/api/browser/mainThreadBrowsers.ts",
